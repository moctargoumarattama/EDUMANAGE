# ============================================================
# KLASORA - Variables d'environnement (.env.example)
# Copier ce fichier en '.env' et renseigner les valeurs réelles.
# ============================================================

# --- Configuration Flask & Sécurité ---
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=changer-cette-cle-secrete-en-production
SECURITY_PASSWORD_SALT=changer-ce-sel-en-production

# --- Base de données ---
# SQLite (développement) :
# DATABASE_URL=sqlite:///ecole.db
# MySQL (production) :
# DATABASE_URL=mysql+pymysql://klasora_user:motdepasse@localhost:3306/klasora_db
DATABASE_URL=sqlite:///ecole.db

# --- Serveur de messagerie (Flask-Mail) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

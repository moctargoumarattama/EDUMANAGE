# ============================================================
# KLASORA - Variables d'environnement (.env.example)
# Copier ce fichier en '.env' et renseigner les valeurs réelles.
# ============================================================

# --- Configuration Flask & Sécurité ---
FLASK_APP=run.py
FLASK_ENV=production
APP_ENV=production
SECRET_KEY=changer-cette-cle-secrete-en-production
SECURITY_PASSWORD_SALT=changer-ce-sel-en-production
SUPERADMIN_PASSWORD=
MAX_CONTENT_LENGTH=20971520
CACHE_DEFAULT_TIMEOUT=300
REDIS_URL=

# --- Base de données ---
# SQLite (développement) :
# DATABASE_URL=sqlite:///ecole.db
# MySQL (production) :
# DATABASE_URL=mysql+pymysql://klasora_user:motdepasse@localhost:3306/klasora_db
DATABASE_URL=sqlite:///ecole.db

# --- Serveur de messagerie (Flask-Mail) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Intégration Google Gmail OAuth 2.0 (Par École) ---
# Clés API créées dans la console Google Cloud (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google/mail/callback

# Clé de chiffrement Fernet (32 bytes url-safe base64) pour chiffrer les refresh tokens en base
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si non définie, une clé dérivée de SECRET_KEY sera utilisée automatiquement en local
MAIL_TOKEN_ENCRYPTION_KEY=


# ============================================================
# KLASORA - .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Environnements virtuels
.venv/
venv/
env/
ENV/

# Bases de données locales
instance/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
*.log.*

# Sauvegardes
backups/
backup/

# Cache QR codes générés
app/static/qrcache/
qrcache/

# Uploads runtime
uploads/
app/static/ecoles/

# Tests & Couverture
.pytest_cache/
.coverage
htmlcov/

# IDE / Système d'exploitation
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Fichiers d'environnement & Secrets
.env
.env.*
!.env.example
